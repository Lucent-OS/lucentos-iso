#!/usr/bin/env bash
set -euo pipefail
# The marker is created only on the installed target.
[[ -f /etc/lucent-installed ]] || exit 0
# Live boot files are generated by archiso instead.
[[ ! -d /run/archiso/bootmnt ]] || exit 0
[[ $(findmnt -n -o FSTYPE -M /boot) == vfat ]] || { echo 'Limine requires a mounted FAT32 /boot.' >&2; exit 1; }
root_uuid="$(findmnt -n -o UUID -M /)"
boot_uuid="$(findmnt -n -o UUID -M /boot)"
[[ -n $root_uuid && -n $boot_uuid ]] || exit 1
[[ -f /boot/vmlinuz-linux && -f /boot/initramfs-linux.img ]] || exit 1
install -d /boot/limine /boot/EFI/BOOT
install -m 0644 /usr/share/limine/limine-bios.sys /boot/limine/
install -m 0644 /usr/share/limine/BOOTX64.EFI /boot/EFI/BOOT/
cat > /boot/limine/limine.conf <<EOF
timeout: 5
/LucentOS
    protocol: linux
    path: uuid(${boot_uuid}):/vmlinuz-linux
    module_path: uuid(${boot_uuid}):/initramfs-linux.img
    cmdline: root=UUID=${root_uuid} rw quiet splash
EOF
cp /boot/limine/limine.conf /boot/EFI/BOOT/limine.conf
# Refresh the BIOS stages alongside limine-bios.sys on package upgrades.
boot_device="$(findmnt -n -o SOURCE -M /boot)"
disk_parent="$(lsblk -ndo PKNAME "$boot_device")"
[[ -n $disk_parent && $disk_parent != *$'\n'* ]] || exit 1
bios_partition="$(lsblk -nr -o PARTTYPE,PARTN "/dev/${disk_parent}" | awk 'tolower($1) == "21686148-6449-6e6f-744e-656564454649" {print $2}')"
[[ -n $bios_partition && $bios_partition != *$'\n'* ]] || exit 1
limine bios-install "/dev/${disk_parent}" "$bios_partition"
